[sub_resource type="Resource" id="Resource_g5omh"]
script = ExtResource("1_sceeb")
lines = PackedStringArray("Like. I personally just really think, she was quite iconic. She contributed so much… No I don’t remember exactly what but she did. And I do quite adore her hairstyle. Sadly I can’t pull it off.", "But like… about this date. We’ve been really getting to know each other. It\'s been… nice. I was honestly expecting a much worse date when we matched. I really am glad I got to meet you. ", "Though, let’s be honest, even a bad date would’ve been better than staying at home. Like once my date literally got eaten by well. We were on a walk thru a pretty field and then they somehow fell in… I never heard them hit the bottom…\n", "I do sometimes still wonder what happened to them…  But it was better than just staying home and watching “Kättemaksu pank”.", "So I feel like to end the date. We should end off with a cuter but also deeper question.", "What is your greatest fear in life?")
topic = SubResource("Resource_yv0id")
on_topic_lines = PackedStringArray("Oh! Honestly I really get that. Same")
off_topic_lines = PackedStringArray("Um... yeah... haha..!!")
out_of_time_lines = PackedStringArray("You should fear running out of time more....")
metadata/_custom_type_script = "uid://b5j37h6jqkfhq"

