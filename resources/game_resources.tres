[sub_resource type="Resource" id="Resource_fto0k"]
resource_local_to_scene = true
script = ExtResource("1_sceeb")
lines = PackedStringArray("Hiiii…… Nice seeing you in the flesh. I’ve been looking forward to this date for a while. Wait that sounds a bit desperate… I just want us to have a fun time.", "Let’s just start from the beginning. So, I’m Lydia Koiduta, well you already know that. I just hope we get to know each other well tonight, or at least have a fun evening. ", "It is kinda of odd though, that you decided to bring me to Hes Kebab. Well, it is a unique first date spot. But. I did say I’m vegan. I don’t think they have a vegan menu, but, it’s fine I don’t mind. Who needs to eat on a first date anyway?", "The music here is like really good though, the vibe is just right. I love the look of it too. So… Good choice I guess…", "I guess we should get to know each other… So um, what do you like to do for fun? ")
topic = SubResource("Resource_yxbnc")
on_topic_lines = PackedStringArray("Oh! I love poetry too! It’s such a lovely poetic art form. But I do sometimes wish it had some more…. Actually nevermind.  ")
off_topic_lines = PackedStringArray("Oh….. that’s…… unfortunate……. Yeah……")
out_of_time_lines = PackedStringArray("Nothing comes to mind...? Okay.....")
metadata/_custom_type_script = "uid://b5j37h6jqkfhq"

