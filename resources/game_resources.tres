[sub_resource type="Resource" id="Resource_2yw20"]
script = ExtResource("1_sceeb")
lines = PackedStringArray("Work is nice and all, but it just takes up so much of our time I wish I could get it all out of my brain quicker. Like imagine only having 48 hours to plan and create something. Sounds so… tiring. I would probably just trade it in for a nap.\n", "Though, napping is actually quite hard in my household. Like, my pet realllllly just adores my attention. To the degree, where… it’s kind of concerning. I love my pet, it’s so wonderful and cheerful but like. I do just wanna sleep sometimes, you know. ", "Also it likes to go thru my wallet when I’m asleep and I don’t know what thats about. I hope it doesn’t end up like the hampster. Or actually do I hope so…. I don’t know…", "Sooo… how are you with animals, you have any furry creatures in your life?")
topic = SubResource("Resource_5es67")
on_topic_lines = PackedStringArray("OMG!! I HAVE ONE!!! THEYRE LIKE SOOOOOOOOOOO CUTEEEEEEEEEEEEEE. Kinda cheeky BUT SO CUUUTE!!!.")
off_topic_lines = PackedStringArray("Well, everyones tastes are different. But… I guess that is technically an acceptable answer. In some way.")
metadata/_custom_type_script = "uid://b5j37h6jqkfhq"

