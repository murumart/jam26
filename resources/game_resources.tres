post_title = "OMG OMG OMGGG MY NECRONOMICON JUST CAMEEEEE!!!! Im like sooooo excited to finally summon the love of my life, Cthula the icon. Like I knowww so many have tried and failed but like. Im different. Im like. Better."
her_comment = "Cthulu is like so basic, everyone is into Cthula at this point. I’m more of a Kratt type of girlie."
love = 7.0
