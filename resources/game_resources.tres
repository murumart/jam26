[sub_resource type="Resource" id="Resource_w83kl"]
script = ExtResource("1_sceeb")
lines = PackedStringArray("Well, maybe….. Okay um actually my favourite poet is this one guy on Glepy, CoopiJoodik123.", "A bit of an untraditional pick, I get it. But the poems are just always so deep and poetic, like they understand the human condition, the joys of life as well as the pitfalls.", " I’ve never really seen anyone else put those feelings into words so clearly, yet beautifully.", "Like, one of my favourite poems is this:\nSlurp up the coffee\nMay our daily stimulants\nBe granted today ", "But yeah… I don’t actually use Glepy thaaaat often, totally. I don’t have a Glepy addiction, but some do and its just so sad to see. Like you’re just leaving whats little more than a ghost version of you online… In just… a big machine. Like I totally wouldn’t do that. Totally\n", "OH! But does have such cute animal pictures sometimes, like, theyre like really adorable.  Kinda like my grandma’s pet hamster….", "It did somehow manage to figure out crypto. No idea how but like, it did invest in. She became a millionaire from it investing in GitCoin before it became big. ", "She doesn’t even have to lift a finger at home now, she literally has an army of hamsters do her bidding now. I don’t know what she pays them with… They just stare into my soul sometimes like they want something…", "On the topic of work, I’m actually an aspiring writer. You might’ve heard of my play, “Säärane Mulgikapsas”, it did tour for a little while. Like, I’m working on another one right now, “Saaremaa onupoja Crypto Casino”.", "What about you? What do you do for work?")
topic = SubResource("Resource_jm3mc")
on_topic_lines = PackedStringArray("Oooh, I\'ve never met a clockmaker before!\t", "I love all sorts of handicrafts, you know... It\'s cool you\'re up to something so meticulous.")
off_topic_lines = PackedStringArray("Interesting... job...?")
out_of_time_lines = PackedStringArray("...erm, the clock ticks nicely... in this establishment...?")
metadata/_custom_type_script = "uid://b5j37h6jqkfhq"

[sub_resource type="Resource" id="Resource_5es67"]
