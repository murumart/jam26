[sub_resource type="Resource" id="Resource_frfyr"]
script = ExtResource("1_sceeb")
lines = PackedStringArray("Like, yeah my pet is actually a KRATT. A lot of people don’t believe they’re real or think it’s like weird to have one. Like okay I had to trick Vanapagan but everyone does that? It’s like a regular Tuesday.", "Oh and like, people keep saying it’s so morally wrong to have one, but like I don’t know where theyre getting that. I dont remember Andrus Kivirähn writing that in his book. I feel like  theyre all just lying to make their chosen magic look better. ", "Like, why is everyone suddenly into eldritch horror? I don\'t get the hype. Like none of you have managed to summon Cthula, why are all of you acting like you’re gonna be the special one that does???", "It’s just… so tiring seeing it all the time. Wait what do you mean you’ve never heard about it or seen it. It’s been like everywhere for months… (It wasn’t just my algorithm right)", "Okay let’s, let’s just move on to a different topic.", "Uhm, actually. I have been wondering about something. It might be a little intrusive though.I don’t want to push you or anything, but like I have just been thinking about it this whole date…", "You bring me to this really… nice and vibey restaurant, okay it is still a Hes Kebab but still. ", "But. You’re…..", "You’re wearing a really cheap Alberta Einstein wig. And I just can’t…. Figure out why. I can’t even think of a reason to wear this to a first date.", "So I have to ask… Why are you wearing it? On this date?")
topic = SubResource("Resource_8otdy")
on_topic_lines = PackedStringArray(" REALLYYYYYYYY??!?!??!?!?!?!?!?! OMG I THOUGHT I WAS THE ONLY ONE!!!!!!!!! \t", "LALLALLAAALALALALALALALAAALAAAAAAAAAAAA", "I’m just so happy. :)))) ")
off_topic_lines = PackedStringArray("……………………………………………………………… okayiguess……")
out_of_time_lines = PackedStringArray("You ran out of eins-time...", "You\'ll lose your hair being so unattentive around me...")
metadata/_custom_type_script = "uid://b5j37h6jqkfhq"

